<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ (API 31+) 备份/迁移规则：应用关闭备份，因此云端备份与设备间迁移均不包含任何数据。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
